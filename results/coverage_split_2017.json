{
 "aggregation": "MicroSeries.sum on analysis flags in each part's frozen simulation; household flags mapped to residents with map_to='person'; parts added in part order. Stored weight columns are not read.",
 "code": {
  "aggregate_tag": "4721d56e6b03f659",
  "commit": "c18aa54830fa6810a0e347d368cb515c30163497"
 },
 "definitions": {
  "a": "covered before, no primary program after",
  "b": "covered before and after, different primary program",
  "c_mcm": "same primary program, value lower, mainly through medicaid_cost, chip or msp_cost",
  "c_other": "same primary program, value lower, mainly through the premium credit, a state program or the CHIP premium",
  "falls": "health value drops by more than $0.005",
  "health_value": "medicaid_cost + chip + msp_cost of the person, plus shares of tax-unit amounts: assigned_aca_ptc over credit-eligible members, state programs over all members, minus chip_premium over CHIP enrollees; shares add up to the household's health value",
  "household_categories": "a strict household's category in a set is the worst over its strict scenarios: any_a > b_no_a > only_c_other > only_c_mcm > other_only > no_fall; only_c = only_c_other + only_c_mcm",
  "other": "value fell with no program before (a CHIP premium share); counted apart",
  "person_buckets": "a person's bucket in a set is the worst over the set's strict scenarios: a > b > c_other > c_mcm > other",
  "primary_program": "first of medicaid (medicaid_enrolled), chip (chip_enrolled), msp (msp_cost > 0), ptc (is_aca_ptc_eligible in a tax unit with assigned_aca_ptc > 0), state (a positive state health program in the tax unit, or or_healthier_oregon_cost)",
  "strict_after_zeroing_all_same_program_mcm_changes": "sensitivity: add back every same-program Medicaid/CHIP/MSP change in either direction, including in households that were not strict",
  "strict_after_zeroing_c": "household members still strict after adding back the medicaid_cost + chip + msp_cost change of every bucket (c) person; premium credit, state subsidy and CHIP premium changes stay"
 },
 "measure": "with_health: change in household_net_income + marketplace_net_premium (health coverage at government cost, premium tax credit counted once); a household is strict when a tested adult's household keeps strictly less than 0% of the gross change (current workers only for raises).",
